{
  "name": "glance",
  "private": true,
  "version": "0.5.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "qr": "evenhub qr",
    "lint:app-json": "node scripts/lint-app-json.mjs",
    "pack": "node scripts/lint-app-json.mjs && evenhub pack app.json dist -o glance.ehpk",
    "deploy": "npm run build && npm run pack && echo '\\nglance.ehpk ready: '$(pwd)'/glance.ehpk\\nUpload to https://hub.evenrealities.com/application'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/regression.mjs",
    "test:backends": "node scripts/test-backends.mjs",
    "hub:upload": "cd ../Cue && node scripts/upload-dev.mjs --manifest ../Glance/app.json"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@evenrealities/evenhub-simulator": "^0.7.3",
    "jsdom": "^29.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  }
}
